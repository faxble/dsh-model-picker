{
  "name": "dsh-model-picker",
  "version": "1.0.1",
  "type": "module",
  "description": "模型速选器（Model Quick Picker）：在会话窗口右下角模型下拉的左侧添加一个小按钮，点击弹出全量模型选择窗口（提供商分组、搜索、提供商筛选、真实 input 能力标签、推理徽章、当前选中高亮），选择后实时回写模型下拉框并立即生效。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "LICENSE",
    "README.md",
    "README.en.md",
    "screenshot_zh.png",
    "screenshot_en.png",
    "button.png",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node --check client.js && node --check index.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model",
    "model-picker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faxble/dsh-model-picker.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale",
        "remote",
        "remote.settings"
      ]
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible"
      }
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
